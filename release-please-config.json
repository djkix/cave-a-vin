{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "tag-separator": "",
      "bump-minor-pre-major": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Fonctionnalités",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Corrections",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "Performances",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Refactorisation",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Intégration continue",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Divers",
          "hidden": true
        }
      ]
    }
  }
}
