{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "tag-separator": "",
      "bump-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Fonctionnalités" },
        { "type": "fix", "section": "Corrections" },
        { "type": "perf", "section": "Performances" },
        { "type": "refactor", "section": "Refactorisation", "hidden": false },
        { "type": "docs", "section": "Documentation", "hidden": false },
        { "type": "test", "section": "Tests", "hidden": false },
        { "type": "ci", "section": "Intégration continue", "hidden": false },
        { "type": "chore", "section": "Divers", "hidden": false }
      ]
    }
  }
}
