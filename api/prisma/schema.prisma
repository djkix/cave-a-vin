generator client {
  provider      = "prisma-client-js"
  // node:22-alpine fournit OpenSSL 3. Sans ce binaryTarget, `prisma generate`
  // installe le moteur « linux-musl » lié à OpenSSL 1.1 et le conteneur meurt au
  // démarrage sur « libssl.so.1.1: No such file or directory ».
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WineColor {
  ROUGE
  BLANC
  ROSE
  PETILLANT
}

enum MovementType {
  IN
  OUT
  ADJUST
}

enum PhotoStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum PhotoPurpose {
  ENTRY
  EXIT
  /// Image trouvée sur le web et choisie comme vignette : jamais analysée ni à confirmer.
  REFERENCE
}

enum VintageQualityLevel {
  GRAND
  MOYEN
  FAIBLE
}

enum AccountStatus {
  /// Inscription Google en attente de validation par un administrateur.
  PENDING
  ACTIVE
  BLOCKED
}

/// Rôle d'un compte dans une cave : propriétaire (un seul, index partiel en
/// migration) ou membre en lecture seule.
enum CaveRole {
  OWNER
  VIEWER
}

enum PairingStatus {
  PENDING
  DONE
  FAILED
}

enum ProducerProfileStatus {
  PENDING
  DONE
  UNKNOWN
  FAILED
}

model Appellation {
  id             String          @id @default(uuid())
  canonicalName  String          @unique @map("canonical_name")
  region         String?
  allowedColors  WineColor[]     @map("allowed_colors")
  guardMinYears  Int?            @map("guard_min_years")
  guardMaxYears  Int?            @map("guard_max_years")
  wines          Wine[]
  guardOverrides GuardOverride[]

  @@map("appellation")
}

model Wine {
  id                       String       @id @default(uuid())
  caveId                   String       @map("cave_id")
  cave                     Cave         @relation(fields: [caveId], references: [id])
  matchKey                 String       @map("match_key")
  producer                 String
  cuvee                    String?
  appellationId            String?      @map("appellation_id")
  appellation              Appellation? @relation(fields: [appellationId], references: [id])
  appellationRaw           String       @map("appellation_raw")
  vintage                  Int?
  color                    WineColor
  formatCl                 Int          @default(75) @map("format_cl")
  apogeeMin                Int?         @map("apogee_min")
  apogeeMax                Int?         @map("apogee_max")
  apogeeSource             String?      @map("apogee_source")
  idealwineRef             String?      @map("idealwine_ref")
  referencePhotoId         String?      @map("reference_photo_id")
  /// Vignette d'avant l'image du web, rétablie par « Revenir à ma photo ».
  referencePhotoPreviousId String?      @map("reference_photo_previous_id")
  /// Provenance de la vignette quand elle vient du web (« Open Food Facts (CC BY-SA) », nom de domaine).
  referencePhotoSource     String?      @map("reference_photo_source")
  referencePhotoSourceUrl  String?      @map("reference_photo_source_url")
  createdAt                DateTime     @default(now()) @map("created_at")
  rating                   Decimal?     @db.Decimal(3, 1)
  ratedAt                  DateTime?    @map("rated_at")
  ratedById                String?      @map("rated_by")
  ratedBy                  AppUser?     @relation(fields: [ratedById], references: [id], onDelete: SetNull)
  pairing                  Pairing?
  movements                Movement[]

  /// Rapprochement par cave : le même vin peut exister dans deux caves.
  /// L'index commence par cave_id et sert aussi de filtre par cave.
  @@unique([caveId, matchKey])
  @@map("wine")
}

model Movement {
  id             String       @id @default(uuid())
  wineId         String       @map("wine_id")
  wine           Wine         @relation(fields: [wineId], references: [id])
  delta          Int
  type           MovementType
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  photoId        String?      @map("photo_id")
  photo          Photo?       @relation(fields: [photoId], references: [id])
  priceUnitCents Int?         @map("price_unit_cents")
  note           String?
  idempotencyKey String       @unique @map("idempotency_key")
  reversesId     String?      @map("reverses_id")
  confirmedWine  Json?        @map("confirmed_wine")

  @@index([wineId, occurredAt])
  @@map("movement")
}

model Photo {
  id            String       @id @default(uuid())
  caveId        String       @map("cave_id")
  cave          Cave         @relation(fields: [caveId], references: [id])
  contentHash   String       @map("content_hash")
  storagePath   String       @map("storage_path")
  mimeType      String       @default("image/jpeg") @map("mime_type")
  status        PhotoStatus  @default(PENDING)
  purpose       PhotoPurpose @default(ENTRY)
  rawExtraction Json?        @map("raw_extraction")
  model         String?
  latencyMs     Int?         @map("latency_ms")
  costCents     Int?         @map("cost_cents")
  errorMessage  String?      @map("error_message")
  createdAt     DateTime     @default(now()) @map("created_at")
  attempts      Int          @default(0)
  nextAttemptAt DateTime?    @map("next_attempt_at")
  dismissedAt   DateTime?    @map("dismissed_at")
  movements     Movement[]

  /// Doublon détecté par cave : deux caves peuvent envoyer la même image.
  @@unique([caveId, contentHash])
  @@index([purpose, status, nextAttemptAt])
  @@map("photo")
}

model AppUser {
  id               String            @id @default(uuid())
  googleSub        String?           @unique @map("google_sub")
  email            String            @unique
  displayName      String?           @map("display_name")
  isBreakGlass     Boolean           @default(false) @map("is_break_glass")
  passwordHash     String?           @map("password_hash")
  status           AccountStatus     @default(ACTIVE)
  isAdmin          Boolean           @default(false) @map("is_admin")
  lastLoginAt      DateTime?         @map("last_login_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  ratedWines       Wine[]
  producerProfiles ProducerProfile[]
  ownedCaves       Cave[]            @relation("CaveOwner")
  caveMemberships  CaveMember[]

  @@map("app_user")
}

/// Une cave : ses vins, photos, exports et recherches d'image. Sans
/// propriétaire seulement si elle a été migrée sur une base sans aucun compte.
model Cave {
  id               String            @id @default(uuid())
  name             String
  ownerId          String?           @map("owner_id")
  owner            AppUser?          @relation("CaveOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now()) @map("created_at")
  members          CaveMember[]
  wines            Wine[]
  photos           Photo[]
  exportLogs       ExportLog[]
  imageSearchCosts ImageSearchCost[]

  @@index([ownerId])
  @@map("cave")
}

/// Accès d'un compte (ou d'une adresse invitée, en attendant sa première
/// connexion) à une cave. Le propriétaire a aussi sa ligne OWNER ; un seul
/// OWNER par cave (index partiel cave_member_one_owner_idx en migration).
model CaveMember {
  id           String   @id @default(uuid())
  caveId       String   @map("cave_id")
  cave         Cave     @relation(fields: [caveId], references: [id], onDelete: Cascade)
  userId       String?  @map("user_id")
  user         AppUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedEmail String?  @map("invited_email")
  role         CaveRole
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([caveId, userId])
  @@unique([caveId, invitedEmail])
  @@index([userId])
  @@index([invitedEmail])
  @@map("cave_member")
}

/// Réglages d'administration (clé, valeur texte), par ex. cave_budget_share = 0.2.
model AppSetting {
  key   String @id
  value String

  @@map("app_setting")
}

model AllowedEmail {
  email   String   @id
  addedBy String?  @map("added_by")
  addedAt DateTime @default(now()) @map("added_at")

  @@map("allowed_email")
}

model ExportLog {
  id          String   @id @default(uuid())
  caveId      String   @map("cave_id")
  cave        Cave     @relation(fields: [caveId], references: [id])
  userId      String   @map("user_id")
  generatedAt DateTime @default(now()) @map("generated_at")
  filter      Json?
  rowCount    Int      @map("row_count")

  @@index([caveId])
  @@map("export_log")
}

/// Qualité d'un millésime pour une région. Absent = non qualifié (facteur 1,0).
model VintageQuality {
  region    String
  year      Int
  quality   VintageQualityLevel
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@id([region, year])
  @@map("vintage_quality")
}

/// Ajustement de garde posé par un administrateur. Vit hors de la ligne
/// `appellation`, que le rechargement du référentiel réécrit à chaque démarrage.
/// `color` vide = toutes couleurs. Unicité par index partiels (migration).
model GuardOverride {
  id            String      @id @default(uuid())
  appellationId String      @map("appellation_id")
  appellation   Appellation @relation(fields: [appellationId], references: [id], onDelete: Cascade)
  color         WineColor?
  guardMinYears Int         @map("guard_min_years")
  guardMaxYears Int         @map("guard_max_years")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("guard_override")
}

model Pairing {
  id           String        @id @default(uuid())
  wineId       String        @unique @map("wine_id")
  wine         Wine          @relation(fields: [wineId], references: [id], onDelete: Cascade)
  status       PairingStatus @default(PENDING)
  dishes       String[]      @default([])
  model        String?
  costCents    Int?          @map("cost_cents")
  errorMessage String?       @map("error_message")
  generatedAt  DateTime?     @map("generated_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("pairing")
}

/// Descriptif d'un domaine, partagé par tous ses vins : lien par la clé
/// normalisée du producteur (normalizeLabel), sans clé étrangère vers wine.
model ProducerProfile {
  id           String                @id @default(uuid())
  producerKey  String                @unique @map("producer_key")
  displayName  String                @map("display_name")
  status       ProducerProfileStatus @default(PENDING)
  description  String?
  source       String                @default("GEMINI")
  model        String?
  costCents    Int?                  @map("cost_cents")
  errorMessage String?               @map("error_message")
  generatedAt  DateTime?             @map("generated_at")
  updatedById  String?               @map("updated_by")
  updatedBy    AppUser?              @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@map("producer_profile")
}

/// Dépense Gemini d'une recherche d'image (site officiel), comptée dans le plafond mensuel.
model ImageSearchCost {
  id        String   @id @default(uuid())
  caveId    String   @map("cave_id")
  cave      Cave     @relation(fields: [caveId], references: [id])
  wineId    String?  @map("wine_id")
  model     String?
  costCents Int      @map("cost_cents")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  /// Dépense du mois par cave (part de budget par cave).
  @@index([caveId, createdAt])
  @@map("image_search_cost")
}
